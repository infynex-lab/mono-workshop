@{
    ViewBag.Title = "Home";
}
<h2>Runtime info</h2>
<table>
    <tr><th>Runtime</th><td>@ViewBag.Runtime</td></tr>
    <tr><th>OS</th><td>@ViewBag.Os</td></tr>
    <tr><th>Host</th><td>@ViewBag.Host</td></tr>
    <tr><th>Newtonsoft.Json (NuGet)</th><td>@ViewBag.Newtonsoft</td></tr>
    <tr><th>Server time</th><td>@ViewBag.Time</td></tr>
</table>
