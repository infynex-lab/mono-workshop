<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.web>
    <compilation debug="true" targetFramework="4.5" />
    <customErrors mode="Off" />
    <!-- Used by Mono (xsp4 / mod_mono) and the IIS classic pipeline -->
    <httpHandlers>
      <add verb="*" path="api/health"   type="Workshop.WebForms.Api.HealthHandler, Workshop.WebForms" />
      <add verb="*" path="api/products" type="Workshop.WebForms.Api.ProductsHandler, Workshop.WebForms" />
    </httpHandlers>
  </system.web>

  <!-- Used by the IIS integrated pipeline (ignored by Mono): the same output also runs on Windows/IIS -->
  <system.webServer>
    <validation validateIntegratedModeConfiguration="false" />
    <handlers>
      <add name="HealthApi"   verb="*" path="api/health"   type="Workshop.WebForms.Api.HealthHandler, Workshop.WebForms" />
      <add name="ProductsApi" verb="*" path="api/products" type="Workshop.WebForms.Api.ProductsHandler, Workshop.WebForms" />
    </handlers>
  </system.webServer>
</configuration>
